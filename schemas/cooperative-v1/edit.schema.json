{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observer cooperative edit v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "value": {},
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "session_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\s/\\\\]+$"
                },
                "reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "kind": {
                  "enum": [
                    "session_event",
                    "local_artifact",
                    "report"
                  ]
                }
              },
              "required": [
                "session_id",
                "reference",
                "kind"
              ],
              "additionalProperties": false
            },
            "maxItems": 100
          },
          "pinned": {
            "type": "boolean"
          },
          "archived": {
            "type": "boolean"
          }
        },
        "required": [
          "item_id",
          "title",
          "value",
          "status",
          "evidence",
          "pinned",
          "archived"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "view": {
      "type": "object",
      "properties": {
        "markdown": {
          "type": "string",
          "maxLength": 16000
        }
      },
      "required": [
        "markdown"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "expected_revision",
    "title",
    "items",
    "view"
  ],
  "additionalProperties": false
}
