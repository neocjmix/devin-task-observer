{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observer cooperative report v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\s/\\\\]+$"
    },
    "expected_revisions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 20,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "changes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 20,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "op": {
                  "const": "define"
                },
                "item_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "value": {},
                "status": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "session_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[^\\s/\\\\]+$"
                      },
                      "reference": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "kind": {
                        "enum": [
                          "session_event",
                          "local_artifact",
                          "report"
                        ]
                      }
                    },
                    "required": [
                      "session_id",
                      "reference",
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 100
                },
                "role": {
                  "enum": [
                    "general",
                    "situation",
                    "intervention",
                    "next_action",
                    "resume",
                    "blocker",
                    "decision",
                    "verification"
                  ]
                },
                "attention_required": {
                  "type": "boolean"
                }
              },
              "required": [
                "op",
                "item_id",
                "title",
                "value",
                "status",
                "evidence"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "const": "update"
                },
                "item_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "value": {},
                "status": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "session_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[^\\s/\\\\]+$"
                      },
                      "reference": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "kind": {
                        "enum": [
                          "session_event",
                          "local_artifact",
                          "report"
                        ]
                      }
                    },
                    "required": [
                      "session_id",
                      "reference",
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 100
                },
                "role": {
                  "enum": [
                    "general",
                    "situation",
                    "intervention",
                    "next_action",
                    "resume",
                    "blocker",
                    "decision",
                    "verification"
                  ]
                },
                "attention_required": {
                  "type": "boolean"
                }
              },
              "required": [
                "op",
                "item_id"
              ],
              "additionalProperties": false,
              "minProperties": 3
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "const": "archive"
                },
                "item_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                }
              },
              "required": [
                "op",
                "item_id"
              ],
              "additionalProperties": false
            }
          ]
        },
        "maxItems": 100
      }
    }
  },
  "required": [
    "schema_version",
    "report_id",
    "session_id",
    "expected_revisions",
    "changes"
  ],
  "additionalProperties": false
}
