{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observer UI read cursors v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "cursors": {
      "type": "object",
      "maxProperties": 10000,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "through_report_revision": {
            "type": "integer",
            "minimum": 1
          },
          "updated_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "through_report_revision",
          "updated_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "revision",
    "cursors"
  ],
  "additionalProperties": false
}
